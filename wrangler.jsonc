{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "pattabi-raman-api",
	"account_id": "011865f296421c95f1b74d28a7de6c79",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"workers_dev": true,
  
	"observability": {
	  "enabled": true
	},
  
	"upload_source_maps": true,
  
	"secrets": {
	  "required": ["API_KEY"]
	},
  
	"d1_databases": [
	  {
		"binding": "DB",
		"database_name": "pattabi-raman-db",
		"database_id": "29fb1f13-aab1-424b-b3c2-f65e95f00403"
	  }
	],
  
	"r2_buckets": [
	  {
		"binding": "IMAGES",
		"bucket_name": "pattabi-raman-images"
	  }
	]
  }